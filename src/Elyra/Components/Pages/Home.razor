@page "/library"
@inject MusicLibraryService Library
@inject FolderPickerService FolderPicker
@inject PlaybackService Playback
@inject NavigationManager Nav
@implements IDisposable

<div class="px-8 py-6">
    <header class="flex items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Mediathek</h1>
            <p class="mt-1 text-sm text-muted">
                @if (Library.Tracks.Count > 0)
                {
                    @($"{Library.Artists.Count} Künstler · {Library.Albums.Count} Alben · {Library.Tracks.Count} Titel")
                }
                else
                {
                    @("Lokale MP3- und FLAC-Dateien, nach Künstlern geordnet.")
                }
            </p>
        </div>
        <button @onclick="ImportAsync" disabled="@Library.IsScanning"
                class="shrink-0 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90 disabled:opacity-50">
            Ordner auswählen
        </button>
    </header>

    @if (_importError is not null)
    {
        <p class="mt-3 text-sm text-red-400">@_importError</p>
    }

    @if (Library.IsScanning)
    {
        <div class="mt-24 flex flex-col items-center justify-center text-center text-muted">
            <div class="h-8 w-8 animate-spin rounded-full border-2 border-line border-t-accent"></div>
            <p class="mt-4 text-sm">Sammlung wird eingelesen …</p>
        </div>
    }
    else if (Library.Artists.Count == 0)
    {
        <div class="mt-20 flex flex-col items-center justify-center text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-surface">
                <svg class="h-7 w-7 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
            </div>
            <h2 class="mt-4 text-lg font-medium">Noch keine Musik</h2>
            <p class="mt-1 max-w-sm text-sm text-muted">Wähle einen Ordner mit deinen Musikdateien, um deine Sammlung zu importieren.</p>
            <button @onclick="ImportAsync" class="mt-5 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white hover:opacity-90">Ordner auswählen</button>
        </div>
    }
    else
    {
        <div class="mt-6 flex flex-wrap items-center gap-3">
            <label class="relative min-w-64 flex-1">
                <span class="sr-only">Mediathek durchsuchen</span>
                <svg class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input value="@_searchText" @oninput="OnSearchInput" placeholder="Diese Ansicht filtern"
                       class="w-full rounded-full border border-line bg-surface py-2 pl-10 pr-4 text-sm text-ink outline-none placeholder:text-muted focus:border-accent" />
            </label>

            <div class="inline-flex rounded-full bg-surface p-1 text-sm" aria-label="Dateiformat filtern">
                @foreach (var option in FormatOptions)
                {
                    <button @onclick="() => SetFormat(option.Value)"
                            class="rounded-full px-3 py-1 transition-colors @(_fileFilter == option.Value ? "bg-surface-2 text-ink" : "text-muted")">
                        @option.Label
                    </button>
                }
            </div>

            <div class="inline-flex rounded-full bg-surface p-1 text-sm" aria-label="Ansicht">
                @foreach (var option in ViewOptions)
                {
                    <button @onclick="() => SetView(option.Value)"
                            class="rounded-full px-3 py-1 transition-colors @(_view == option.Value ? "bg-surface-2 text-ink" : "text-muted")">
                        @option.Label
                    </button>
                }
            </div>

            @if (_view == LibraryView.Artists)
            {
                <div class="inline-flex rounded-full bg-surface p-1 text-sm" aria-label="Sortierung">
                    <button @onclick="() => SetSort(false)"
                            class="rounded-full px-3 py-1 transition-colors @(_sortByTrackCount ? "text-muted" : "bg-surface-2 text-ink")">Künstler</button>
                    <button @onclick="() => SetSort(true)"
                            class="rounded-full px-3 py-1 transition-colors @(_sortByTrackCount ? "bg-surface-2 text-ink" : "text-muted")">Titelanzahl</button>
                </div>
            }
        </div>

        @if (_view == LibraryView.Artists)
        {
            @if (VisibleArtists.Count == 0)
            {
                <div class="mt-20 flex flex-col items-center text-center text-muted">
                    <h2 class="text-lg font-medium text-ink">Keine Treffer</h2>
                    <p class="mt-1 text-sm">Passe Suche oder Dateiformat an.</p>
                    <button @onclick="ResetFilters" class="mt-4 text-sm text-accent hover:underline">Filter zurücksetzen</button>
                </div>
            }
            else
            {
                <p class="mt-4 text-xs text-muted">@Math.Min(VisibleArtists.Count, _visibleLimit) von @VisibleArtists.Count Künstlern angezeigt</p>
                <div class="mt-3 overflow-visible rounded-xl border border-line bg-surface/40">
                    <div class="grid grid-cols-[2rem_minmax(0,1fr)_7rem_6rem_2rem] gap-3 border-b border-line px-4 py-2 text-xs uppercase tracking-wide text-muted">
                        <span></span>
                        <span>Künstler</span>
                        <span class="text-right">Alben</span>
                        <span class="text-right">Titel</span>
                        <span></span>
                    </div>
                    @foreach (var artist in VisibleArtists.Take(_visibleLimit))
                    {
                        <article @onclick="() => OpenArtist(artist.Id)"
                                 class="group grid cursor-pointer grid-cols-[2rem_minmax(0,1fr)_7rem_6rem_2rem] items-center gap-3 border-b border-line/70 px-4 py-3 transition-colors last:border-b-0 hover:bg-surface-2">
                            <button @onclick="() => Playback.Play(artist.Tracks)" @onclick:stopPropagation
                                    class="flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-accent hover:text-white"
                                    aria-label="Alle Titel von @artist.Name abspielen">
                                <svg class="h-4 w-4 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                            </button>
                            <div class="flex min-w-0 items-center gap-3">
                                <div class="h-9 w-9 shrink-0 overflow-hidden rounded-lg bg-surface-2">
                                    @if (artist.CoverArtDataUri is not null) { <img src="@artist.CoverArtDataUri" alt="" loading="lazy" class="h-full w-full object-cover" /> }
                                    else { <span class="flex h-full items-center justify-center text-accent">♫</span> }
                                </div>
                                <div class="min-w-0">
                                <h2 class="truncate text-sm font-medium text-ink group-hover:text-accent">@artist.Name</h2>
                                @if (artist.Albums.Count > 0)
                                {
                                    <p class="mt-0.5 truncate text-xs text-muted">@string.Join(" · ", artist.Albums.Take(3).Select(album => album.Title))</p>
                                }
                                else
                                {
                                    <p class="mt-0.5 text-xs text-muted">Songs ohne Albumangabe</p>
                                }
                                </div>
                            </div>
                            <span class="text-right text-sm tabular-nums text-muted">@artist.AlbumCount</span>
                            <span class="text-right text-sm tabular-nums text-muted">@artist.TrackCount</span>
                            <svg class="h-4 w-4 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
                        </article>
                    }
                </div>
                @if (VisibleArtists.Count > _visibleLimit)
                {
                    <button @onclick="ShowMore" class="mt-4 rounded-full bg-surface-2 px-5 py-2.5 text-sm hover:bg-line">Weitere Künstler anzeigen</button>
                }
            }
        }
        else if (_view == LibraryView.Genres)
        {
            @if (VisibleGenres.Count == 0)
            {
                <div class="mt-20 flex flex-col items-center text-center text-muted">
                    <h2 class="text-lg font-medium text-ink">Keine Treffer</h2>
                    <p class="mt-1 text-sm">Passe Suche oder Dateiformat an, oder Songs haben kein Genre-Tag.</p>
                    <button @onclick="ResetFilters" class="mt-4 text-sm text-accent hover:underline">Filter zurücksetzen</button>
                </div>
            }
            else
            {
                <p class="mt-4 text-xs text-muted">@Math.Min(VisibleGenres.Count, _visibleLimit) von @VisibleGenres.Count Genres angezeigt</p>
                <div class="mt-3 overflow-visible rounded-xl border border-line bg-surface/40">
                    <div class="grid grid-cols-[minmax(0,1fr)_7rem_6rem_2rem] gap-3 border-b border-line px-4 py-2 text-xs uppercase tracking-wide text-muted">
                        <span>Genre</span>
                        <span class="text-right">Alben</span>
                        <span class="text-right">Titel</span>
                        <span></span>
                    </div>
                    @foreach (var genre in VisibleGenres.Take(_visibleLimit))
                    {
                        <article @onclick="() => OpenGenre(genre.Id)"
                                 class="group grid cursor-pointer grid-cols-[minmax(0,1fr)_7rem_6rem_2rem] items-center gap-3 border-b border-line/70 px-4 py-3 transition-colors last:border-b-0 hover:bg-surface-2">
                            <h2 class="min-w-0 truncate text-sm font-medium text-ink group-hover:text-accent">@genre.Name</h2>
                            <span class="text-right text-sm tabular-nums text-muted">@genre.AlbumCount</span>
                            <span class="text-right text-sm tabular-nums text-muted">@genre.TrackCount</span>
                            <svg class="h-4 w-4 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
                        </article>
                    }
                </div>
                @if (VisibleGenres.Count > _visibleLimit)
                {
                    <button @onclick="ShowMore" class="mt-4 rounded-full bg-surface-2 px-5 py-2.5 text-sm hover:bg-line">Weitere Genres anzeigen</button>
                }
            }
        }
        else
        {
            @if (VisibleAlbums.Count == 0)
            {
                <div class="mt-20 flex flex-col items-center text-center text-muted">
                    <h2 class="text-lg font-medium text-ink">Keine Treffer</h2>
                    <p class="mt-1 text-sm">Passe Suche oder Dateiformat an.</p>
                    <button @onclick="ResetFilters" class="mt-4 text-sm text-accent hover:underline">Filter zurücksetzen</button>
                </div>
            }
            else
            {
                <p class="mt-4 text-xs text-muted">@Math.Min(VisibleAlbums.Count, _visibleLimit) von @VisibleAlbums.Count Alben angezeigt</p>
                <div class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                    @foreach (var album in VisibleAlbums.Take(_visibleLimit))
                    {
                        <button @onclick="() => OpenAlbum(album.Id)" class="group min-w-0 rounded-xl p-2 text-left transition hover:bg-surface">
                            <div class="aspect-square overflow-hidden rounded-xl bg-gradient-to-br from-accent/35 to-surface-2 shadow-lg shadow-black/15">
                                @if (album.CoverArtDataUri is not null) { <img src="@album.CoverArtDataUri" alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" /> }
                                else { <span class="flex h-full items-center justify-center text-5xl text-accent/80">♫</span> }
                            </div>
                            <span class="mt-2 block truncate text-sm font-semibold">@album.Title</span>
                            <span class="block truncate text-xs text-muted">@album.Artist · @album.TrackCount Titel</span>
                        </button>
                    }
                </div>
                @if (VisibleAlbums.Count > _visibleLimit)
                {
                    <button @onclick="ShowMore" class="mt-4 rounded-full bg-surface-2 px-5 py-2.5 text-sm hover:bg-line">Weitere Alben anzeigen</button>
                }
            }
        }
    }
</div>

@code {
    private enum LibraryView { Artists, Genres, Albums }

    private bool _sortByTrackCount;
    private string _searchText = "";
    private AudioFileFilter _fileFilter = AudioFileFilter.All;
    private LibraryView _view = LibraryView.Artists;
    private string? _importError;
    private int _visibleLimit = 60;

    private static readonly (AudioFileFilter Value, string Label)[] FormatOptions =
    [
        (AudioFileFilter.All, "Alle"),
        (AudioFileFilter.Mp3, "MP3"),
        (AudioFileFilter.Flac, "FLAC")
    ];

    private static readonly (LibraryView Value, string Label)[] ViewOptions =
    [
        (LibraryView.Artists, "Künstler"),
        (LibraryView.Genres, "Genres"),
        (LibraryView.Albums, "Alben")
    ];

    private IReadOnlyList<Artist> VisibleArtists
    {
        get
        {
            var artists = LibraryFilter.Apply(Library.Artists, _searchText, _fileFilter);
            return _sortByTrackCount
                ? artists.OrderByDescending(artist => artist.TrackCount)
                    .ThenBy(artist => artist.Name, StringComparer.CurrentCultureIgnoreCase)
                    .ToList()
                : artists;
        }
    }

    private IReadOnlyList<Genre> VisibleGenres =>
        LibraryFilter.Apply(Library.Genres, _searchText, _fileFilter);

    private IReadOnlyList<Album> VisibleAlbums =>
        LibraryFilter.Apply(Library.Albums, _searchText, _fileFilter);

    protected override void OnInitialized() => Library.Changed += OnLibraryChanged;
    private void OnLibraryChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    private void OpenArtist(string id) => Nav.NavigateTo($"/artist/{id}");
    private void OpenGenre(string id) => Nav.NavigateTo($"/genre/{id}");
    private void OpenAlbum(string id) => Nav.NavigateTo($"/album/{id}");

    private async Task ImportAsync()
    {
        _importError = null;
        try
        {
            var folder = await FolderPicker.PickFolderAsync();
            if (!string.IsNullOrEmpty(folder))
                await Library.ImportFolderAsync(folder);
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
        }
    }

    private void ResetFilters()
    {
        _searchText = "";
        _fileFilter = AudioFileFilter.All;
        _visibleLimit = 60;
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? "";
        _visibleLimit = 60;
    }

    private void SetFormat(AudioFileFilter value) { _fileFilter = value; _visibleLimit = 60; }
    private void SetView(LibraryView value) { _view = value; _visibleLimit = 60; }
    private void SetSort(bool value) { _sortByTrackCount = value; _visibleLimit = 60; }
    private void ShowMore() => _visibleLimit += 60;

    public void Dispose() => Library.Changed -= OnLibraryChanged;
}
