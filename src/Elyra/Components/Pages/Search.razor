@page "/search"
@inject MusicLibraryService Library
@inject PlaybackService Playback
@inject NavigationManager Nav
@implements IDisposable

@{
    var query = _query.Trim();
    var songs = string.IsNullOrEmpty(query) ? [] : Library.Tracks
        .Where(track => Contains(track.Title, query) || Contains(track.Artist, query) || Contains(track.Album, query))
        .OrderBy(track => SearchRank(track.Title, track.Artist, query))
        .ThenBy(track => track.Title, StringComparer.CurrentCultureIgnoreCase).ToList();
    var albums = string.IsNullOrEmpty(query) ? [] : Library.Albums
        .Where(album => Contains(album.Title, query) || Contains(album.Artist, query))
        .Take(12).ToList();
    var artists = string.IsNullOrEmpty(query) ? [] : Library.Artists
        .Where(artist => Contains(artist.Name, query))
        .Take(12).ToList();
}

<div class="mx-auto max-w-6xl px-8 py-8">
    <header>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Alles an einem Ort</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Suche</h1>
        <p class="mt-2 text-sm text-muted">Finde Titel, Alben und Künstler in deiner lokalen Sammlung.</p>
    </header>

    <label class="relative mt-7 block">
        <span class="sr-only">Musik durchsuchen</span>
        <svg class="pointer-events-none absolute left-4 top-3.5 h-5 w-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input @ref="_searchInput" data-elyra-search @bind="_query" @bind:event="oninput" placeholder="Titel, Album oder Künstler suchen"
               class="w-full rounded-2xl border border-line bg-surface py-3 pl-12 pr-4 text-base text-ink outline-none placeholder:text-muted focus:border-accent" />
    </label>

    @if (string.IsNullOrEmpty(query))
    {
        <p class="mt-10 text-sm text-muted">Tipp: Mit <kbd class="rounded border border-line bg-surface px-1.5 py-0.5">/</kbd> öffnest du die Suche von überall.</p>
    }
    else if (songs.Count == 0 && albums.Count == 0 && artists.Count == 0)
    {
        <div class="mt-14 rounded-2xl border border-line bg-surface p-8 text-center">
            <h2 class="text-lg font-semibold">Keine Treffer für „@query“</h2>
            <p class="mt-2 text-sm text-muted">Versuche einen kürzeren Namen oder einen anderen Teil des Titels.</p>
        </div>
    }
    else
    {
        @if (songs.Count > 0)
        {
            <section class="mt-9">
                <h2 class="mb-3 text-lg font-semibold">Titel <span class="text-sm font-normal text-muted">@songs.Count</span></h2>
                <div class="overflow-hidden rounded-xl border border-line bg-surface/40">
                    @for (var i = 0; i < Math.Min(songs.Count, _songLimit); i++)
                    {
                        var index = i;
                        var song = songs[index];
                        <div class="flex items-center gap-3 border-b border-line/70 px-3 py-2 last:border-b-0 hover:bg-surface-2">
                            <button @onclick="() => Playback.Play(songs, index)" class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface-2" aria-label="@song.Title abspielen">
                                @if (song.CoverArtDataUri is not null) { <img src="@song.CoverArtDataUri" alt="" loading="lazy" class="h-full w-full object-cover" /> }
                                else { <span class="text-accent">▶</span> }
                            </button>
                            <div class="min-w-0 flex-1"><div class="truncate text-sm font-medium">@song.Title</div><div class="truncate text-xs text-muted">@song.Artist · @song.Album</div></div>
                            <span class="hidden text-xs tabular-nums text-muted sm:block">@song.DurationLabel</span>
                            <button @onclick="() => Playback.PlayNext(song)" class="flex h-8 w-8 items-center justify-center rounded-full text-muted hover:bg-accent/15 hover:text-accent" aria-label="@song.Title als Nächstes spielen" title="Als Nächstes spielen">↳</button>
                            <AddToPlaylistButton Track="song" />
                        </div>
                    }
                </div>
                @if (songs.Count > _songLimit)
                {
                    <button @onclick="() => _songLimit += 30" class="mt-3 rounded-full bg-surface-2 px-4 py-2 text-sm hover:bg-line">Weitere Titel anzeigen</button>
                }
            </section>
        }

        @if (albums.Count > 0)
        {
            <section class="mt-9">
                <h2 class="mb-3 text-lg font-semibold">Alben</h2>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                    @foreach (var album in albums)
                    {
                        <button @onclick="() => OpenAlbum(album.Id)" class="flex min-w-0 items-center gap-3 rounded-xl border border-line bg-surface p-2 text-left hover:border-accent/50">
                            <span class="h-12 w-12 shrink-0 overflow-hidden rounded-lg bg-surface-2">
                                @if (album.CoverArtDataUri is not null) { <img src="@album.CoverArtDataUri" alt="" loading="lazy" class="h-full w-full object-cover" /> }
                                else { <span class="flex h-full items-center justify-center text-accent">♫</span> }
                            </span>
                            <span class="min-w-0"><span class="block truncate text-sm font-medium">@album.Title</span><span class="block truncate text-xs text-muted">@album.Artist</span></span>
                        </button>
                    }
                </div>
            </section>
        }

        @if (artists.Count > 0)
        {
            <section class="mt-9 pb-6">
                <h2 class="mb-3 text-lg font-semibold">Künstler</h2>
                <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var artist in artists)
                    {
                        <button @onclick="() => OpenArtist(artist.Id)" class="flex min-w-0 items-center gap-3 rounded-xl border border-line bg-surface p-3 text-left hover:border-accent/50">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">♫</span>
                            <span class="min-w-0"><span class="block truncate text-sm font-medium">@artist.Name</span><span class="block text-xs text-muted">@artist.TrackCount Titel</span></span>
                        </button>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private string _query = "";
    private int _songLimit = 20;
    private ElementReference _searchInput;

    protected override void OnInitialized() => Library.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _searchInput.FocusAsync();
    }

    private static bool Contains(string? value, string query) =>
        value?.Contains(query, StringComparison.CurrentCultureIgnoreCase) == true;

    private static int SearchRank(string title, string artist, string query)
    {
        if (title.StartsWith(query, StringComparison.CurrentCultureIgnoreCase)) return 0;
        if (Contains(title, query)) return 1;
        if (artist.StartsWith(query, StringComparison.CurrentCultureIgnoreCase)) return 2;
        if (Contains(artist, query)) return 3;
        return 4;
    }

    private void OpenAlbum(string id) => Nav.NavigateTo($"/album/{id}");
    private void OpenArtist(string id) => Nav.NavigateTo($"/artist/{id}");
    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);
    public void Dispose() => Library.Changed -= OnChanged;
}
