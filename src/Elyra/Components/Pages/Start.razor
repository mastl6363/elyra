@page "/"
@inject MusicLibraryService Library
@inject UserMusicDataService UserMusic
@inject PlaybackService Playback
@implements IDisposable

<div class="mx-auto max-w-6xl px-8 py-7">
    <header>
        <div class="text-xs font-medium uppercase tracking-widest text-accent">Elyra</div>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight">Guten Tag</h1>
        <p class="mt-1 text-sm text-muted">Deine Musik, direkt dort, wo du aufgehört hast.</p>
    </header>

    @if (Library.Tracks.Count == 0)
    {
        <section class="mt-10 rounded-2xl border border-line bg-gradient-to-br from-accent/20 to-surface p-8">
            <h2 class="text-xl font-semibold">Deine Mediathek wartet</h2>
            <p class="mt-2 max-w-xl text-sm text-muted">Importiere einen Musikordner, um Künstler, Lieblingssongs, Verlauf und Wiedergabelisten zu verwenden.</p>
            <a href="library" class="mt-5 inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white hover:opacity-90">Mediathek öffnen</a>
        </section>
    }
    else
    {
        @if (Playback.HasRestoredSession && Playback.Current is { } restored)
        {
            <section class="mt-8 flex items-center gap-5 rounded-2xl border border-accent/30 bg-gradient-to-r from-accent/20 to-surface p-5">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-surface-2">
                    @if (ResolveCover(restored) is { } cover)
                    {
                        <img src="@cover" alt="" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                    }
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-xs font-medium uppercase tracking-wide text-accent">Weiterhören</div>
                    <h2 class="mt-1 truncate text-lg font-semibold">@restored.Title</h2>
                    <p class="truncate text-sm text-muted">@restored.Artist · bei @Format(Playback.Position)</p>
                </div>
                <button @onclick="Playback.ResumeLastSession" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent text-white shadow-lg shadow-accent/20 hover:scale-105" aria-label="Wiedergabe fortsetzen">
                    <svg class="h-5 w-5 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </button>
            </section>
        }

        <section class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <a href="favorites" class="group rounded-xl border border-line bg-surface p-5 transition hover:-translate-y-0.5 hover:bg-surface-2">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-accent to-accent-2 text-white">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                </div>
                <h2 class="mt-4 font-semibold group-hover:text-accent">Lieblingssongs</h2>
                <p class="mt-1 text-sm text-muted">@FavoriteTracks.Count Titel</p>
            </a>
            <a href="library" class="group rounded-xl border border-line bg-surface p-5 transition hover:-translate-y-0.5 hover:bg-surface-2">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-2 text-accent">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                </div>
                <h2 class="mt-4 font-semibold group-hover:text-accent">Mediathek</h2>
                <p class="mt-1 text-sm text-muted">@Library.Artists.Count Künstler · @Library.Tracks.Count Titel</p>
            </a>
            <a href="playlists" class="group rounded-xl border border-line bg-surface p-5 transition hover:-translate-y-0.5 hover:bg-surface-2">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-2 text-accent">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h13M3 12h13M3 18h9M17 14v6M14 17h6" /></svg>
                </div>
                <h2 class="mt-4 font-semibold group-hover:text-accent">Wiedergabelisten</h2>
                <p class="mt-1 text-sm text-muted">Deine zusammengestellte Musik</p>
            </a>
        </section>

        @if (RecentTracks.Count > 0)
        {
            <section class="mt-10">
                <div class="mb-3 flex items-end justify-between">
                    <div>
                        <h2 class="text-xl font-semibold tracking-tight">Zuletzt gehört</h2>
                        <p class="mt-1 text-xs text-muted">Dein lokaler Wiedergabeverlauf</p>
                    </div>
                </div>
                <div class="rounded-xl border border-line bg-surface/40 p-2">
                    <TrackList Tracks="RecentTracks" />
                </div>
            </section>
        }

        @if (MostPlayedTracks.Count > 1)
        {
            <section class="mt-10">
                <h2 class="text-xl font-semibold tracking-tight">Häufig gehört</h2>
                <div class="mt-3 rounded-xl border border-line bg-surface/40 p-2">
                    <TrackList Tracks="MostPlayedTracks" />
                </div>
            </section>
        }
    }
</div>

@code {
    private IReadOnlyList<Track> FavoriteTracks => UserMusic.ResolveFavorites(Library.Tracks);
    private IReadOnlyList<Track> RecentTracks => UserMusic.RecentlyPlayed(Library.Tracks, 8);
    private IReadOnlyList<Track> MostPlayedTracks => UserMusic.MostPlayed(Library.Tracks, 6);

    protected override void OnInitialized()
    {
        UserMusic.Changed += OnChanged;
        Library.Changed += OnChanged;
        Playback.CurrentChanged += OnChanged;
    }

    private string? ResolveCover(Track restored) =>
        Library.Tracks.FirstOrDefault(track =>
            string.Equals(track.FilePath, restored.FilePath, StringComparison.OrdinalIgnoreCase))?.CoverArtDataUri;
    private static string Format(TimeSpan value) =>
        value.TotalHours >= 1 ? value.ToString(@"h\:mm\:ss") : value.ToString(@"m\:ss");
    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserMusic.Changed -= OnChanged;
        Library.Changed -= OnChanged;
        Playback.CurrentChanged -= OnChanged;
    }
}
