@page "/smart-playlist/{Id}"
@inject SmartPlaylistService SmartPlaylists
@inject PlaybackService Playback
@inject NavigationManager Nav
@implements IDisposable
@inject MusicLibraryService Library
@inject UserMusicDataService UserMusic

@{
    var playlist = SmartPlaylists.Find(Id);
}

@if (playlist is null)
{
    <div class="px-8 py-6">
        <p class="text-sm text-muted">Intelligente Wiedergabeliste nicht gefunden.</p>
        <a href="/playlists" class="mt-3 inline-block text-sm text-accent hover:underline">Zurück zu den Wiedergabelisten</a>
    </div>
}
else
{
    <div class="mx-auto max-w-5xl px-8 py-6">
        <button @onclick="BackToPlaylists" class="mb-6 inline-flex items-center gap-2 text-sm text-muted hover:text-ink">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg>
            Wiedergabelisten
        </button>
        <header class="border-b border-line pb-7">
            <div class="text-xs font-medium uppercase tracking-wide text-accent">Intelligente Wiedergabeliste · @playlist.Accent</div>
            <h1 class="mt-2 text-4xl font-semibold tracking-tight">@playlist.Name</h1>
            <p class="mt-2 max-w-2xl text-sm text-muted">@playlist.Description · @playlist.Tracks.Count Titel</p>
            <button @onclick="() => Playback.Play(playlist.Tracks)" disabled="@(playlist.Tracks.Count == 0)"
                    class="mt-5 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white hover:opacity-90 disabled:opacity-40">
                Abspielen
            </button>
        </header>
        <div class="mt-7 rounded-xl border border-line bg-surface/40 p-2">
            @if (playlist.Tracks.Count == 0)
            {
                <p class="px-4 py-10 text-center text-sm text-muted">Diese Liste enthält momentan keine Titel.</p>
            }
            else
            {
                <TrackList Tracks="playlist.Tracks" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    protected override void OnInitialized()
    {
        Library.Changed += OnChanged;
        UserMusic.Changed += OnChanged;
    }

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);
    private void BackToPlaylists() => Nav.NavigateTo("/playlists");

    public void Dispose()
    {
        Library.Changed -= OnChanged;
        UserMusic.Changed -= OnChanged;
    }
}
