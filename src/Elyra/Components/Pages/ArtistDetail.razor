@page "/artist/{Id}"
@inject MusicLibraryService Library
@inject PlaybackService Playback
@inject NavigationManager Nav

@{
    var artist = Library.FindArtist(Id);
}

@if (artist is null)
{
    <div class="px-8 py-6">
        <p class="text-sm text-muted">Künstler nicht gefunden.</p>
        <a href="/library" class="mt-3 inline-block text-sm text-accent hover:underline">Zurück zur Mediathek</a>
    </div>
}
else
{
    var looseTracks = artist.Tracks
        .Where(track => string.IsNullOrWhiteSpace(track.Album))
        .OrderBy(track => track.Title, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    <div class="mx-auto max-w-5xl px-8 py-6">
        <button @onclick="BackToLibrary"
                class="mb-6 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg>
            Mediathek
        </button>

        <header class="border-b border-line pb-7">
            <div class="text-xs uppercase tracking-wide text-accent">Künstler</div>
            <h1 class="mt-2 truncate text-4xl font-semibold tracking-tight">@artist.Name</h1>
            <p class="mt-2 text-sm text-muted">@artist.AlbumCount Alben · @artist.TrackCount Titel</p>
            <button @onclick="() => Playback.Play(artist.Tracks)"
                    class="mt-5 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white hover:opacity-90">
                <svg class="h-4 w-4 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                Alle abspielen
            </button>
        </header>

        @foreach (var album in artist.Albums)
        {
            <section class="mt-10">
                <div class="mb-3 flex items-end gap-4 border-b border-line px-3 pb-3">
                    <div class="min-w-0 flex-1">
                        <div class="text-xs uppercase tracking-wide text-muted">Album</div>
                        <button @onclick="() => OpenAlbum(album.Id)"
                                class="mt-1 block max-w-full truncate text-left text-xl font-semibold hover:text-accent hover:underline">
                            @album.Title
                        </button>
                        <p class="mt-1 text-xs text-muted">@album.TrackCount Titel</p>
                    </div>
                    <button @onclick="() => OpenAlbum(album.Id)" class="rounded-full px-4 py-2 text-sm text-muted hover:bg-surface-2 hover:text-ink">Album öffnen</button>
                    <button @onclick="() => Playback.Play(album.Tracks)" class="rounded-full bg-surface-2 px-4 py-2 text-sm hover:bg-line">Abspielen</button>
                </div>
                <TrackList Tracks="album.Tracks" ShowAdd="true" />
            </section>
        }

        @if (looseTracks.Count > 0)
        {
            <section class="mt-10">
                <div class="mb-3 px-3">
                    <h2 class="text-lg font-semibold">Songs</h2>
                    <p class="mt-1 text-xs text-muted">Titel ohne Albumangabe</p>
                </div>
                <TrackList Tracks="looseTracks" ShowAdd="true" />
            </section>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private void BackToLibrary() => Nav.NavigateTo("/library");

    private void OpenAlbum(string albumId) =>
        Nav.NavigateTo($"/album/{albumId}?fromArtist={Uri.EscapeDataString(Id)}");
}
