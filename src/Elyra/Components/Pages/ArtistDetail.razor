@page "/artist/{Id}"
@inject MusicLibraryService Library
@inject PlaybackService Playback

@{
    var artist = Library.FindArtist(Id);
}

@if (artist is null)
{
    <div class="px-8 py-6">
        <p class="text-sm text-muted">Künstler nicht gefunden.</p>
        <a href="" class="mt-3 inline-block text-sm text-accent hover:underline">Zurück zur Mediathek</a>
    </div>
}
else
{
    var looseTracks = artist.Tracks
        .Where(track => string.IsNullOrWhiteSpace(track.Album))
        .OrderBy(track => track.Title, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    <div class="mx-auto max-w-5xl px-8 py-6">
        <header class="flex items-end gap-5">
            <div class="flex h-40 w-40 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface shadow-xl shadow-black/30">
                @if (artist.CoverArtDataUri is not null)
                {
                    <img src="@artist.CoverArtDataUri" alt="@artist.Name" class="h-full w-full object-cover" />
                }
                else
                {
                    <span class="text-5xl font-semibold text-accent">@Initials(artist.Name)</span>
                }
            </div>
            <div class="min-w-0 flex-1">
                <div class="text-xs uppercase tracking-wide text-muted">Künstler</div>
                <h1 class="mt-1 truncate text-4xl font-semibold tracking-tight">@artist.Name</h1>
                <p class="mt-2 text-sm text-muted">@artist.AlbumCount Alben · @artist.TrackCount Titel</p>
                <button @onclick="() => Playback.Play(artist.Tracks)"
                        class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white hover:opacity-90">
                    <svg class="h-4 w-4 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    Alle abspielen
                </button>
            </div>
        </header>

        @foreach (var album in artist.Albums)
        {
            <section class="mt-10">
                <div class="mb-3 flex items-center gap-4 px-3">
                    <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface">
                        @if (album.CoverArtDataUri is not null)
                        {
                            <img src="@album.CoverArtDataUri" alt="" class="h-full w-full object-cover" />
                        }
                        else
                        {
                            <svg class="h-6 w-6 text-line" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <h2 class="truncate text-lg font-semibold">@album.Title</h2>
                        <p class="text-xs text-muted">@album.TrackCount Titel</p>
                    </div>
                    <button @onclick="() => Playback.Play(album.Tracks)" class="rounded-full bg-surface-2 px-4 py-2 text-sm hover:bg-line">Abspielen</button>
                </div>
                <TrackList Tracks="album.Tracks" ShowAdd="true" />
            </section>
        }

        @if (looseTracks.Count > 0)
        {
            <section class="mt-10">
                <div class="mb-3 px-3">
                    <h2 class="text-lg font-semibold">Songs</h2>
                    <p class="mt-1 text-xs text-muted">Titel ohne Albumangabe</p>
                </div>
                <TrackList Tracks="looseTracks" ShowAdd="true" />
            </section>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
