@page "/now-playing"
@inject PlaybackService Playback
@inject AudioPlayerService Audio
@inject QueuePanelState QueueState
@inject VideoPlaybackService VideoPlayback
@implements IDisposable

@{
    var current = Playback.Current;
    var station = Playback.CurrentStation;
    var video = Playback.CurrentVideo;
    var upcoming = Playback.Upcoming;
}

<div class="px-8 py-8">
    @if (current is null && station is null && video is null)
    {
        <div class="mt-24 flex flex-col items-center justify-center text-center text-muted">
            <svg class="h-12 w-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
            </svg>
            <p class="mt-4 text-sm">Es läuft gerade nichts.</p>
        </div>
    }
    else if (station is not null)
    {
        <div class="flex flex-col items-center text-center">
            <div class="flex h-64 w-64 items-center justify-center overflow-hidden rounded-2xl bg-surface shadow-2xl shadow-black/40">
                @if (RadioStation.IsHttpUrl(station.Favicon))
                {
                    <img src="@station.Favicon" alt="@station.Name" class="h-full w-full object-cover" />
                }
                else
                {
                    <svg class="h-20 w-20 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M5 12a7 7 0 0 1 14 0v7H5z" /><path d="M9 12a3 3 0 0 1 6 0" /><circle cx="12" cy="12" r="1" />
                    </svg>
                }
            </div>

            <div class="mt-6 flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-accent">
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Live Radio
            </div>
            <h1 class="mt-2 max-w-xl truncate text-2xl font-semibold tracking-tight">@station.Name</h1>
            <p class="mt-1 text-sm text-muted">@station.Details</p>
            @if (station.TagList.Count > 0)
            {
                <p class="mt-2 text-xs text-muted">@string.Join(" · ", station.TagList)</p>
            }

            <div class="mt-8">
                <TransportControls Large="true" />
            </div>
        </div>
    }
    else if (video is not null)
    {
        <div class="flex flex-col items-center text-center">
            <div class="flex h-64 w-64 items-center justify-center rounded-2xl bg-surface shadow-2xl shadow-black/40">
                <svg class="h-20 w-20 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m10 9 5 3-5 3z" /></svg>
            </div>
            <div class="mt-6 text-xs font-medium uppercase tracking-widest text-accent">@(video.Kind == VideoSourceKind.Dvd ? "DVD" : "Film")</div>
            <h1 class="mt-2 max-w-xl truncate text-2xl font-semibold tracking-tight">@video.Title</h1>
            <p class="mt-1 text-sm text-muted">Die Wiedergabe läuft im nativen Videofenster.</p>

            <div class="mt-4 flex gap-2">
                <button @onclick="() => VideoPlayback.OpenAsync(video)" class="rounded-full bg-accent px-4 py-2 text-sm font-medium text-white hover:opacity-90">Videofenster anzeigen</button>
                <button @onclick="VideoPlayback.CloseAsync" class="rounded-full bg-surface-2 px-4 py-2 text-sm hover:bg-line">Film schließen</button>
            </div>

            <div class="mt-6 flex w-full max-w-md items-center gap-2 text-xs tabular-nums text-muted">
                <span>@Format(Audio.Position)</span>
                <input type="range" class="elyra-range flex-1" min="0" max="@MaxSeconds" value="@CurrentSeconds" aria-label="Wiedergabeposition"
                       style="@ProgressStyle" @onchange="OnSeek" />
                <span>@Format(Audio.Duration)</span>
            </div>

            <div class="mt-6"><TransportControls Large="true" /></div>
        </div>
    }
    else if (current is not null)
    {
        <div class="flex flex-col items-center text-center">
            <div class="h-72 w-72 overflow-hidden rounded-3xl bg-gradient-to-br from-accent/35 to-surface-2 shadow-2xl shadow-black/50 lg:h-80 lg:w-80">
                @if (current.CoverArtDataUri is not null)
                {
                    <img src="@current.CoverArtDataUri" alt="@current.Title" class="h-full w-full object-cover" />
                }
                else
                {
                    <div class="flex h-full w-full items-center justify-center">
                        <svg class="h-16 w-16 text-line" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
                        </svg>
                    </div>
                }
            </div>

            <h1 class="mt-7 max-w-xl truncate text-3xl font-semibold tracking-tight">@current.Title</h1>
            <p class="mt-1 text-base text-muted">@current.Artist · @current.Album</p>

            <div class="mt-6 flex w-full max-w-md items-center gap-2 text-xs tabular-nums text-muted">
                <span>@Format(Audio.Position)</span>
                <input type="range" class="elyra-range flex-1" min="0" max="@MaxSeconds" value="@CurrentSeconds" aria-label="Wiedergabeposition"
                       style="@ProgressStyle" @onchange="OnSeek" />
                <span>@Format(Audio.Duration)</span>
            </div>

            <div class="mt-6">
                <TransportControls Large="true" />
            </div>
        </div>

        @if (upcoming.Count > 0)
        {
            <div class="mx-auto mt-12 max-w-2xl">
                <div class="mb-2 flex items-center justify-between px-3"><h2 class="text-xs font-medium uppercase tracking-wide text-muted">Als Nächstes</h2><button @onclick="QueueState.Open" class="text-sm text-accent hover:underline">Warteschlange öffnen</button></div>
                @foreach (var track in upcoming.Take(5))
                {
                    <div class="flex items-center justify-between gap-4 border-b border-line px-3 py-2 text-sm last:border-b-0"><span class="truncate">@track.Title <span class="text-muted">· @track.Artist</span></span><span class="shrink-0 text-xs text-muted">@track.DurationLabel</span></div>
                }
            </div>
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Playback.CurrentChanged += OnChanged;
        Audio.StateChanged += OnChanged;
        Audio.PositionChanged += OnPosition;
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    private void OnPosition(object? sender, TimeSpan t) => InvokeAsync(StateHasChanged);

    private int MaxSeconds => Math.Max(1, (int)Audio.Duration.TotalSeconds);
    private int CurrentSeconds => (int)Audio.Position.TotalSeconds;

    private void OnSeek(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
            Playback.Seek(TimeSpan.FromSeconds(seconds));
    }

    private string ProgressStyle
    {
        get
        {
            var d = Audio.Duration.TotalMilliseconds;
            var pct = d > 0 ? Audio.Position.TotalMilliseconds / d * 100 : 0;
            var p = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            return $"background-image:linear-gradient(to right, var(--color-accent) {p}%, var(--color-surface-2) {p}%)";
        }
    }

    private static string Format(TimeSpan t) =>
        t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");

    public void Dispose()
    {
        Playback.CurrentChanged -= OnChanged;
        Audio.StateChanged -= OnChanged;
        Audio.PositionChanged -= OnPosition;
    }
}
