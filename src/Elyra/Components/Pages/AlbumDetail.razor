@page "/album/{Id}"
@inject MusicLibraryService Library
@inject PlaybackService Playback
@inject NavigationManager Nav

@{
    var album = Library.FindAlbum(Id);
}

@if (album is null)
{
    <div class="px-8 py-6">
        <p class="text-sm text-muted">Album nicht gefunden.</p>
        <a href="/library" class="mt-3 inline-block text-sm text-accent hover:underline">Zurück zur Mediathek</a>
    </div>
}
else
{
    <div class="mx-auto max-w-5xl px-8 py-6">
        <button @onclick="NavigateBack"
                class="mb-6 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg>
            @(string.IsNullOrWhiteSpace(FromArtist) ? "Mediathek" : "Künstler")
        </button>

        <header class="border-b border-line pb-7">
            <div class="min-w-0 flex-1">
                <div class="text-xs uppercase tracking-wide text-muted">Album</div>
                <h1 class="mt-2 truncate text-4xl font-semibold tracking-tight">@album.Title</h1>
                <p class="mt-1 text-sm text-muted">@album.Artist · @album.TrackCount Titel</p>
                <button @onclick="() => Playback.Play(album.Tracks)"
                        class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">
                    <svg class="h-4 w-4 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    Abspielen
                </button>
            </div>
        </header>

        <div class="mt-8">
            <TrackList Tracks="album.Tracks" ShowAdd="true" />
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter, SupplyParameterFromQuery(Name = "fromArtist")]
    public string? FromArtist { get; set; }

    private void NavigateBack() => Nav.NavigateTo(
        string.IsNullOrWhiteSpace(FromArtist)
            ? "/library"
            : $"/artist/{FromArtist}");
}
