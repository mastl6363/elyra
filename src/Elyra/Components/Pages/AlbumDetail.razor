@page "/album/{Id}"
@inject MusicLibraryService Library
@inject PlaybackService Playback

@{
    var album = Library.FindAlbum(Id);
}

@if (album is null)
{
    <div class="px-8 py-6">
        <p class="text-sm text-muted">Album nicht gefunden.</p>
        <a href="library" class="mt-3 inline-block text-sm text-accent hover:underline">Zurück zur Mediathek</a>
    </div>
}
else
{
    <div class="px-8 py-6">
        <header class="flex items-end gap-5">
            <div class="h-40 w-40 shrink-0 overflow-hidden rounded-xl bg-surface shadow-lg shadow-black/30">
                @if (album.CoverArtDataUri is not null)
                {
                    <img src="@album.CoverArtDataUri" alt="@album.Title" class="h-full w-full object-cover" />
                }
                else
                {
                    <div class="flex h-full w-full items-center justify-center">
                        <svg class="h-12 w-12 text-line" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
                        </svg>
                    </div>
                }
            </div>
            <div class="min-w-0 flex-1">
                <div class="text-xs uppercase tracking-wide text-muted">Album</div>
                <h1 class="mt-1 truncate text-3xl font-semibold tracking-tight">@album.Title</h1>
                <p class="mt-1 text-sm text-muted">@album.Artist · @album.TrackCount Titel</p>
                <button @onclick="() => Playback.Play(album.Tracks)"
                        class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">
                    <svg class="h-4 w-4 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    Abspielen
                </button>
            </div>
        </header>

        <div class="mt-8">
            <TrackList Tracks="album.Tracks" ShowAdd="true" />
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
}
