@inject PlaybackService Playback
@inject AudioPlayerService Audio
@inject MiniPlayerService MiniMode
@inject NavigationManager Nav
@implements IDisposable

@{
    var track = Playback.Current;
    var station = Playback.CurrentStation;
    var video = Playback.CurrentVideo;
    var hasMedia = Playback.HasCurrent;
}

<div class="flex h-screen min-h-0 flex-col overflow-hidden bg-canvas text-ink">
    <div class="h-1 shrink-0 bg-surface-2">
        @if (station is not null)
        {
            <div class="h-full w-full bg-accent"></div>
        }
        else
        {
            <div class="h-full bg-accent transition-[width]" style="width:@ProgressPercent%"></div>
        }
    </div>

    <div class="flex min-h-0 flex-1 items-center gap-3 px-4 py-3">
        <button @onclick="OpenNowPlaying" class="h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-surface-2" aria-label="Aktuelle Wiedergabe öffnen">
            @if (track?.CoverArtDataUri is not null)
            {
                <img src="@track.CoverArtDataUri" alt="" class="h-full w-full object-cover" />
            }
            else if (station is not null && RadioStation.IsHttpUrl(station.Favicon))
            {
                <img src="@station.Favicon" alt="" class="h-full w-full object-cover" />
            }
            else
            {
                <span class="flex h-full w-full items-center justify-center text-accent">
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>
                </span>
            }
        </button>

        <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-semibold">@(track?.Title ?? station?.Name ?? video?.Title ?? "Kein Titel")</div>
            <div class="mt-0.5 truncate text-xs text-muted">@(track?.Artist ?? station?.Country ?? (video is not null ? "Film" : "Elyra"))</div>
            <div class="mt-3 flex items-center gap-4">
                <button @onclick="Playback.Previous" disabled="@(track is null)" class="text-muted hover:text-ink disabled:opacity-30" aria-label="Zurück">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h2v14H6zM20 5v14l-11-7z" /></svg>
                </button>
                <button @onclick="Playback.TogglePlayPause" disabled="@(!hasMedia)" class="flex h-10 w-10 items-center justify-center rounded-full bg-ink text-canvas disabled:opacity-30" aria-label="@(Playback.IsPlaying ? "Pause" : "Abspielen")">
                    @if (Playback.IsPlaying)
                    {
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
                    }
                    else
                    {
                        <svg class="h-5 w-5 translate-x-px" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    }
                </button>
                <button @onclick="Playback.Next" disabled="@(track is null)" class="text-muted hover:text-ink disabled:opacity-30" aria-label="Weiter">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M16 5h2v14h-2zM4 5l11 7-11 7z" /></svg>
                </button>
            </div>
        </div>

        <button @onclick="MiniMode.Exit" class="self-start rounded-lg p-2 text-muted hover:bg-surface hover:text-ink" aria-label="Vollansicht" title="Vollansicht">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
        </button>
    </div>

    @if (station is null)
    {
        <div class="flex shrink-0 items-center gap-2 border-t border-line px-4 py-2 text-[11px] tabular-nums text-muted">
            <span class="w-10 text-right">@PlaybackTimeFormatter.FormatElapsed(Playback.Position)</span>
            <input type="range" class="elyra-range flex-1" min="0" max="@MaxSeconds" value="@CurrentSeconds" disabled="@(!hasMedia)" @onchange="OnSeek" />
            <span class="w-10">@PlaybackTimeFormatter.FormatRemaining(Playback.Position, Playback.Duration)</span>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _refreshCancellation = new();
    private int MaxSeconds => Math.Max(1, (int)Playback.Duration.TotalSeconds);
    private int CurrentSeconds => Math.Max(0, (int)Playback.Position.TotalSeconds);
    private string ProgressPercent => (Playback.Duration.TotalMilliseconds > 0
            ? Math.Clamp(Playback.Position.TotalMilliseconds / Playback.Duration.TotalMilliseconds * 100, 0, 100)
            : 0)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        Playback.CurrentChanged += OnChanged;
        Audio.StateChanged += OnChanged;
        Audio.PositionChanged += OnPosition;
        _ = RefreshProgressAsync(_refreshCancellation.Token);
    }

    private void OpenNowPlaying()
    {
        MiniMode.Exit();
        Nav.NavigateTo("/now-playing");
    }

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);
    private void OnPosition(object? sender, TimeSpan position) => InvokeAsync(StateHasChanged);
    private void OnSeek(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var seconds))
            Playback.Seek(TimeSpan.FromSeconds(seconds));
    }

    private async Task RefreshProgressAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (Playback.IsPlaying)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _refreshCancellation.Cancel();
        Playback.CurrentChanged -= OnChanged;
        Audio.StateChanged -= OnChanged;
        Audio.PositionChanged -= OnPosition;
        _refreshCancellation.Dispose();
    }
}
