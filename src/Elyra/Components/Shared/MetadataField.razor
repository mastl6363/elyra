<div class="grid grid-cols-[1.5rem_7rem_minmax(0,1fr)] items-center gap-3">
    <input type="checkbox" checked="@Enabled" @onchange="OnEnabledChanged"
           class="h-4 w-4 rounded border-line bg-canvas accent-accent" aria-label="@Label ändern" />
    <span class="text-sm text-muted">@Label</span>
    <div class="@(!Enabled ? "pointer-events-none opacity-40" : "")">@ChildContent</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OnEnabledChanged(ChangeEventArgs args) =>
        EnabledChanged.InvokeAsync(args.Value is true);
}
