@inject PlaybackService Playback
@implements IDisposable

<div class="flex flex-col">
    @for (var i = 0; i < Tracks.Count; i++)
    {
        var index = i;
        var track = Tracks[index];
        var isCurrent = Playback.Current?.FilePath == track.FilePath;

        <div class="group flex items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-surface-2 @(isCurrent ? "bg-surface-2" : "")">
            <button @onclick="() => Playback.Play(Tracks, index)" class="w-6 shrink-0 text-center" aria-label="Abspielen">
                @if (isCurrent)
                {
                    <svg class="mx-auto h-4 w-4 text-accent" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                }
                else
                {
                    <span class="text-sm text-muted group-hover:hidden">@(index + 1)</span>
                    <svg class="mx-auto hidden h-4 w-4 text-ink group-hover:block" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                }
            </button>

            <div class="min-w-0 flex-1">
                <div class="truncate text-sm @(isCurrent ? "text-accent" : "text-ink")">@track.Title</div>
                <div class="truncate text-xs text-muted">@track.Artist</div>
            </div>

            <div class="shrink-0 text-xs tabular-nums text-muted">@track.DurationLabel</div>

            @if (ShowFavorite)
            {
                <FavoriteButton Track="track" />
            }
            @if (ShowAdd)
            {
                <AddToPlaylistButton Track="track" />
            }
            @if (ShowQueueActions)
            {
                <TrackActionsButton Track="track" />
            }
            @if (ShowRemove)
            {
                <button @onclick="() => OnRemove.InvokeAsync(track)"
                        class="shrink-0 text-muted opacity-0 transition-colors hover:text-ink group-hover:opacity-100"
                        title="Entfernen" aria-label="Entfernen">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Track> Tracks { get; set; } = Array.Empty<Track>();
    [Parameter] public bool ShowAdd { get; set; } = true;
    [Parameter] public bool ShowFavorite { get; set; } = true;
    [Parameter] public bool ShowQueueActions { get; set; } = true;
    [Parameter] public bool ShowRemove { get; set; }
    [Parameter] public EventCallback<Track> OnRemove { get; set; }

    protected override void OnInitialized() => Playback.CurrentChanged += OnChanged;
    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Playback.CurrentChanged -= OnChanged;
}
